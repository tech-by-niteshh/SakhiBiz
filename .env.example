# ==============================================================================
# SakhiBiz — Production-Minded Environment Configuration
# ==============================================================================
# Copy this file to '.env' (for local development) and set these environment
# variables in your Vercel Project Settings for production deployment.
# NEVER commit real credentials, passwords, or session secrets to Git.

# ------------------------------------------------------------------------------
# 1. MongoDB Atlas (Source of Truth for Identity & Authentication)
# ------------------------------------------------------------------------------
# Obtain from MongoDB Atlas -> Database -> Connect -> Drivers:
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/sakhibiz?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# 2. JWT & HttpOnly Session Security
# ------------------------------------------------------------------------------
# High-entropy secret string used to sign session tokens stored in HttpOnly cookies:
JWT_SECRET="replace-with-a-random-32-char-string-or-openssl-rand-hex-32"

# ------------------------------------------------------------------------------
# 3. Initial Administrator Bootstrap
# ------------------------------------------------------------------------------
# When a user registers with this exact normalized email, the backend automatically
# bootstraps their role to 'ADMIN'. Subsequent role changes are managed in Admin Panel.
INITIAL_ADMIN_EMAIL="owner@example.com"

# ------------------------------------------------------------------------------
# 4. Google Sheets CMS & Apps Script Web App Gateway
# ------------------------------------------------------------------------------
# Google Apps Script Web App URL (Deploy as Web app -> Execute as: Me -> Access: Anyone):
APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycb.../exec"

# Shared secret verification token. MUST match the 'APPS_SCRIPT_SHARED_SECRET'
# stored in Apps Script Project Settings -> Script Properties:
APPS_SCRIPT_SHARED_SECRET="replace-with-a-strong-shared-secret-token"

# ------------------------------------------------------------------------------
# 5. Multi-Key AI Providers & Secure Encryption (Server-Side Only)
# ------------------------------------------------------------------------------
# High-entropy 32+ char secret for AES-256-GCM encryption of stored API keys:
ENCRYPTION_SECRET="replace-with-a-random-32-char-string-for-aes256-key-encryption"

# Groq LPU Keys (Single key or multiple keys separated by commas/newlines):
GROQ_API_KEYS="gsk_key1, gsk_key2"
# Legacy single key fallback:
# GROQ_API_KEY="gsk_key1"
GROQ_MODEL="llama-3.3-70b-versatile"

# Google Gemini Keys (Single key or multiple keys separated by commas/newlines):
GEMINI_API_KEYS="AIzaSyA_key1, AIzaSyB_key2"
# Legacy single key fallback:
# GEMINI_API_KEY="AIzaSyA_key1"
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 6. Application Host URL & Port
# ------------------------------------------------------------------------------
APP_URL="http://localhost:3000"
PORT=3000
